# @nuxtjs/supabase v1 อ่าน NUXT_PUBLIC_* ผ่าน nuxt.config.ts
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_your_key_here

# (ทางเลือก) ชื่อ env ตรงตาม module — ใช้แทน NUXT_PUBLIC_* ได้
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=sb_publishable_your_key_here

# (ทางเลือก) Build version — CI ที่ไม่มี .git ให้ inject commit เอง
# NUXT_PUBLIC_GIT_COMMIT=abc1234
# NUXT_PUBLIC_GIT_COMMIT_DATE=2026-06-08T10:00:00+07:00
